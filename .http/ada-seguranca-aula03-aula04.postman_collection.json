    {
      "name": "Aula 04 - Parte 1: OAuth 2.0 Playground (Topicos 4 e 5)",
      "item": [
        {
          "name": "1.1 [Auth Code + PKCE] Passo 1: Ana autoriza app-impressao (fotos:leitura)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res && res.code) {",
                  "  pm.collectionVariables.set('oauthCode', res.code);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"ana\",\n  \"password\": \"senha123\",\n  \"clientId\": \"app-impressao\",\n  \"scope\": \"fotos:leitura\",\n  \"state\": \"xyz-anti-csrf-987\",\n  \"codeChallenge\": \"8765359d832d82a372f2c0d38c0632c823331bc35f39c214c6506ca938c9166f\"\n}"
            },
            "url": {
              "raw": "{{host}}/oauth/autorizar",
              "host": ["{{host}}"],
              "path": ["oauth", "autorizar"]
            }
          }
        },
        {
          "name": "1.2 [PKCE em acao] Atacante tenta trocar code com codeVerifier errado -> 401",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"grantType\": \"authorization_code\",\n  \"code\": \"{{oauthCode}}\",\n  \"clientId\": \"app-impressao\",\n  \"codeVerifier\": \"chute-errado-do-atacante\"\n}"
            },
            "url": {
              "raw": "{{host}}/oauth/token",
              "host": ["{{host}}"],
              "path": ["oauth", "token"]
            }
          }
        },
        {
          "name": "1.3 Passo 2: app-impressao troca code + codeVerifier correto pelo Access Token -> 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res && res.accessToken) {",
                  "  pm.collectionVariables.set('oauthAccessToken', res.accessToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"grantType\": \"authorization_code\",\n  \"code\": \"{{oauthCode}}\",\n  \"clientId\": \"app-impressao\",\n  \"codeVerifier\": \"meu-segredo-pkce-123\"\n}"
            },
            "url": {
              "raw": "{{host}}/oauth/token",
              "host": ["{{host}}"],
              "path": ["oauth", "token"]
            }
          }
        },
        {
          "name": "1.4 Tentar reutilizar o MESMO code uma segunda vez -> 401",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"grantType\": \"authorization_code\",\n  \"code\": \"{{oauthCode}}\",\n  \"clientId\": \"app-impressao\",\n  \"codeVerifier\": \"meu-segredo-pkce-123\"\n}"
            },
            "url": {
              "raw": "{{host}}/oauth/token",
              "host": ["{{host}}"],
              "path": ["oauth", "token"]
            }
          }
        },
        {
          "name": "1.5 Passo 3: app-impressao le as fotos da Ana (GET /oauth/recursos/fotos) -> 200",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{oauthAccessToken}}" }],
            "url": {
              "raw": "{{host}}/oauth/recursos/fotos",
              "host": ["{{host}}"],
              "path": ["oauth", "recursos", "fotos"]
            }
          }
        },
        {
          "name": "1.6 Passo 4: app-impressao tenta APAGAR as fotos (DELETE) -> 403 Escopo Insuficiente",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{oauthAccessToken}}" }],
            "url": {
              "raw": "{{host}}/oauth/recursos/fotos",
              "host": ["{{host}}"],
              "path": ["oauth", "recursos", "fotos"]
            }
          }
        },
        {
          "name": "1.7 [Client Credentials M2M] servico-relatorios pede token sem usuario -> 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res && res.accessToken) {",
                  "  pm.collectionVariables.set('tokenM2M', res.accessToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"grantType\": \"client_credentials\",\n  \"clientId\": \"servico-relatorios\",\n  \"clientSecret\": \"segredo-relatorios-123\",\n  \"scope\": \"relatorios:leitura\"\n}"
            },
            "url": {
              "raw": "{{host}}/oauth/token",
              "host": ["{{host}}"],
              "path": ["oauth", "token"]
            }
          }
        },
        {
          "name": "1.8 [Client Credentials M2M] servico-relatorios acessa relatorios -> 200",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenM2M}}" }],
            "url": {
              "raw": "{{host}}/oauth/recursos/relatorios",
              "host": ["{{host}}"],
              "path": ["oauth", "recursos", "relatorios"]
            }
          }
        }
      ]
    },
    {
      "name": "Aula 04 - Parte 2: Access + Refresh Token Rotation (Topico 6)",
      "item": [
        {
          "name": "2.1 Login da Ana -> Devolve par { accessToken, refreshToken }",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res && res.accessToken) {",
                  "  pm.collectionVariables.set('accessToken', res.accessToken);",
                  "  pm.collectionVariables.set('refreshTokenAntigo', res.refreshToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"ana\",\n  \"password\": \"senha123\"\n}"
            },
            "url": {
              "raw": "{{host}}/auth/login",
              "host": ["{{host}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "2.2 Acessar /auth/me com Access Token -> 200 OK",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{host}}/auth/me",
              "host": ["{{host}}"],
              "path": ["auth", "me"]
            }
          }
        },
        {
          "name": "2.3 Acessar /auth/me SEM token -> 401 Unauthorized",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{host}}/auth/me",
              "host": ["{{host}}"],
              "path": ["auth", "me"]
            }
          }
        },
        {
          "name": "2.4 Tentar usar Refresh Token em /auth/me -> 401 (token_use=refresh bloqueado!)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{refreshTokenAntigo}}" }],
            "url": {
              "raw": "{{host}}/auth/me",
              "host": ["{{host}}"],
              "path": ["auth", "me"]
            }
          }
        },
        {
          "name": "2.5 Acessar /auth/admin/painel com Ana (USER) -> 403 Forbidden",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{host}}/auth/admin/painel",
              "host": ["{{host}}"],
              "path": ["auth", "admin", "painel"]
            }
          }
        },
        {
          "name": "2.6 ROTACAO: Renovar em /auth/refresh -> Invalida antigo e emite par novo!",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res && res.accessToken) {",
                  "  pm.collectionVariables.set('accessTokenNovo', res.accessToken);",
                  "  pm.collectionVariables.set('refreshTokenNovo', res.refreshToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshTokenAntigo}}\"\n}"
            },
            "url": {
              "raw": "{{host}}/auth/refresh",
              "host": ["{{host}}"],
              "path": ["auth", "refresh"]
            }
          }
        },
        {
          "name": "2.7 DETECCAO DE REUSO (Alarme!): Tentar usar refreshTokenAntigo de novo -> 401 + Revoga Familia!",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshTokenAntigo}}\"\n}"
            },
            "url": {
              "raw": "{{host}}/auth/refresh",
              "host": ["{{host}}"],
              "path": ["auth", "refresh"]
            }
          }
        },
        {
          "name": "2.8 Prova do Alarme: Ate o refreshTokenNovo foi revogado -> 401!",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshTokenNovo}}\"\n}"
            },
            "url": {
              "raw": "{{host}}/auth/refresh",
              "host": ["{{host}}"],
              "path": ["auth", "refresh"]
            }
          }
        }
      ]
    }
  ]
}
