              "mode": "raw",
              "raw": "{\n  \"token\": \"{{algNoneHeader}}.{{algNonePayload}}.\"\n}"
            },
            "url": {
              "raw": "{{host}}/jwt/validar",
              "host": ["{{host}}"],
              "path": ["jwt", "validar"]
            }
          }
        },
        {
          "name": "4.3a Gerar token ja expirado (-10s)",
