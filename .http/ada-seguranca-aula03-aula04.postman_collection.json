              "mode": "raw",
              "raw": "{\n  \"usuario\": \"ana\",\n  \"expiraEmSegundos\": -10\n}"
            },
            "url": {
              "raw": "{{host}}/jwt/gerar",
              "host": ["{{host}}"],
              "path": ["jwt", "gerar"]
            }
          }
        },
        {
          "name": "4.3b Validar token expirado -> Recusado",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{tokenExpirado}}\"\n}"
