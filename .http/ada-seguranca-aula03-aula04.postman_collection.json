    {
      "name": "Aula 03 - Revisao JWT (Topicos 1, 2 e 3 da Aula 04)",
      "item": [
        {
          "name": "2.1 Login por Token (ana)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res && res.token) {",
                  "  pm.collectionVariables.set('token', res.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"ana\",\n  \"password\": \"senha123\"\n}"
            },
            "url": {
              "raw": "{{host}}/jwt/login",
              "host": ["{{host}}"],
              "path": ["jwt", "login"]
            }
          }
        },
        {
          "name": "3.1 Decodificar JWT sem chave",
